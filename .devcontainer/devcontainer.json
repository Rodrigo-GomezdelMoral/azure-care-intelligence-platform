{
  "name": "azure-care-intelligence-platform",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": { "extensions": "ml" },
    "ghcr.io/azure/azure-dev/azd:0": {}
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && cp -n .env.example .env",
  "forwardPorts": [8000],
  "customizations": { "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-azuretools.vscode-bicep"] } }
}
