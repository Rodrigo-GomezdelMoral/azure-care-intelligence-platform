# Local defaults. The container app and the pipeline jobs receive the Azure values from Bicep; nothing here is a secret.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-careintel-prod-swc
AML_WORKSPACE=mlw-careintel-prod-swc
AML_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
MODEL_NAME=readmission-risk
ONLINE_ENDPOINT=ep-readmission-risk
BATCH_ENDPOINT=bep-cohort-scoring
POSTGRES_HOST=<server>.postgres.database.azure.com
POSTGRES_DATABASE=care
POSTGRES_USER=<entra-user-or-identity-name>
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
API_AUDIENCE=api://<api-app-registration-client-id>
API_APP_ROLE=Care.Read
REQUIRE_AUTH=false
CONTACT_COST_EUR=35
READMISSION_COST_EUR=4800
INTERVENTION_EFFECTIVENESS=0.25
WEEKLY_CAPACITY=200
